{
  "mcpServers": {
    "unity-mcp": {
      "title": "Unity MCP",
      "description": "Inspect and automate the active Unity Editor project through MCP for Unity 10.1.2.",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./scripts/start-unity-mcp-stdio.ps1"
      ],
      "cwd": ".",
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 300,
      "default_tools_approval_mode": "writes"
    }
  }
}
