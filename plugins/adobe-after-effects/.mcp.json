{
  "mcpServers": {
    "after_effects": {
      "title": "Adobe After Effects",
      "description": "Inspect and automate the active After Effects project through ae-mcp.",
      "command": "powershell.exe",
      "args": ["-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "./scripts/start-ae-mcp.ps1"],
      "cwd": ".",
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 300,
      "default_tools_approval_mode": "writes"
    }
  }
}
