{
  "mcpServers": {
    "photoshop": {
      "title": "Adobe Photoshop",
      "description": "Inspect and edit local Photoshop documents through photoshop-python-api and Windows COM.",
      "command": "powershell.exe",
      "args": ["-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "./scripts/start-photoshop-mcp.ps1"],
      "cwd": ".",
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 300,
      "default_tools_approval_mode": "writes"
    }
  }
}
